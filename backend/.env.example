# MongoDB Configuration
MONGODB_URL=mongodb+srv://username:password@cluster.mongodb.net/splitwise?retryWrites=true&w=majority

# JWT Configuration
SECRET_KEY=your-super-secret-key-change-this-in-production
ALGORITHM=HS256
ACCESS_TOKEN_EXPIRE_MINUTES=10080

# CORS Origins (comma-separated list of allowed origins)
# For production, add your frontend URL after deployment
# Example: CORS_ORIGINS=https://your-app.vercel.app,https://another-domain.com
CORS_ORIGINS=

